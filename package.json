{
  "name": "haru-story",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": ["apps/client", "services/admin"],
  "scripts": {
    "dev:client": "npm run tauri --workspace=apps/client -- dev",
    "dev:client:web": "npm run dev --workspace=apps/client",
    "dev:admin": "npm run dev --workspace=services/admin",
    "dev:backend": "uv run --project services/backend --locked python -m granian --interface asgi --host 127.0.0.1 --port 8000 haru_backend.app:app",
    "build": "npm run build --workspaces",
    "build:client:desktop": "npm run tauri --workspace=apps/client -- build --no-bundle -- --locked",
    "check": "npm run typecheck --workspaces && uv run --project services/backend --locked python -m pytest && npm run schema:check",
    "schema:export": "uv run --project services/backend --locked python tooling/export_graphql_schema.py",
    "schema:check": "npm run schema:export -- --check"
  }
}
