{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haru Story",
  "version": "0.1.0",
  "identifier": "org.harustory.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "하루 이야기",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000",
      "devCsp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:1420 http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
